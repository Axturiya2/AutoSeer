<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AutoSeerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoSeer">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MissionListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DailyTasksActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.MoreActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ScriptListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ScriptEditActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DelaySettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CardCaptureActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FactorListActivity"
            android:exported="false" />

        <service
            android:name=".service.AutoSeerService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".input.GestureAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
